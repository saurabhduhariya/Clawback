# Razorpay Test Mode Keys (get from dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Webhook signing secret from the Razorpay dashboard (Settings -> Webhooks).
# REQUIRED for /api/webhooks/razorpay — the route rejects every request without
# it, and boot fails outright when NODE_ENV=production.
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API Key (get from aistudio.google.com)
# Comma-separate several keys to rotate between them.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx

# Server
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Security (Phase 2)
# ---------------------------------------------------------------------------
# Shared secret for the protected endpoints (/api/transactions, /api/recovery,
# /api/scheduler, /api/chat, /api/export). The client sends the same value as
# VITE_API_KEY. Unset in development = routes stay open with a warning; unset in
# production = protected routes return 503.
API_KEY=

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true only to disable rate limiting during local load testing.
RATE_LIMIT_DISABLED=false

# Statement timeout (ms) for the chatbot's read-only SQL tool.
SQL_TOOL_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Customer notifications (Phase 2 / P2-5)
# ---------------------------------------------------------------------------
# OFF by default: the agent still creates real Razorpay payment links and
# invoices, but does NOT SMS/email the customer. The seeded demo data contains
# fabricated contacts, so leave this false unless you own every address in the DB.
NOTIFY_CUSTOMERS=false

# Optional. When NOTIFY_CUSTOMERS=true outside production, only these emails or
# phone numbers may actually be notified. Empty = notify everyone.
NOTIFY_ALLOWLIST=
