# Backend base URL. Leave unset for local dev — Vite proxies /api to :3001.
# VITE_API_URL=https://your-backend.onrender.com

# Shared secret matching the server's API_KEY. Sent as x-api-key on protected
# calls, and as ?api_key= for the SSE stream and the CSV download (neither can
# set headers).
#
# NOTE: anything here is compiled into the JS bundle and readable by anyone who
# loads the page. This stops drive-by abuse of the deployed demo — it is not real
# authentication. Use real sessions if this outlives the hackathon.
VITE_API_KEY=
